# Public URL of the site (canonical links, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon (owner dashboard counters only). Pooled for the app, unpooled for migrations.
DATABASE_URL=


# Better Auth (single owner, signups disabled)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The owner account is created with `npm run owner:sql` (asks for email and password, prints SQL for the Neon editor).
# No owner email or password is ever stored in an env file.
